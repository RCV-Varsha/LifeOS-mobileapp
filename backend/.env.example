# PostgreSQL connection
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lifeos
PGUSER=lifeos
PGPASSWORD=replace-me

# Development identity only. This is selected by the server, never by clients.
# Authentication defaults to real sessions. Set AUTH_MODE=development only for local legacy testing.
AUTH_MODE=session
DEV_USER_ID=00000000-0000-4000-8000-000000000001
WEB_ORIGINS=http://localhost:8081,http://localhost:8082

# Optional AI configuration
GROQ_API_KEY=replace-me
GROQ_MODEL=replace-me

# Semantic search automatically uses Gemini embeddings when GEMINI_API_KEY is set.
GEMINI_API_KEY=
# Optional compatible embedding endpoint override (set all three together).
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional V11 context, scoped to DEV_USER_ID. Keep private feed URLs server-side.
CALENDAR_ICS_URL=https://calendar.example/private-feed.ics
WEATHER_LATITUDE=17.385
WEATHER_LONGITUDE=78.487
WEATHER_LOCATION=Hyderabad

# Multimodal file summaries and suggested tasks
GEMINI_DOCUMENT_MODEL=gemini-3.6-flash
