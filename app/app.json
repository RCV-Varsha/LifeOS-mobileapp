{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/lifeos-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chakravarshini.lifeos",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F6F2"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b5a588cb-4743-4fb1-98ec-460415bae5b7"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/lifeos-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F2"
        }
      ],
      "./plugins/withWindowsCxxDriver",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
